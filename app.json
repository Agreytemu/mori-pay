{
  "expo": {
    "name": "Mori Pay",
    "slug": "lipa-na-agreytemu",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lipanaagreytemu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07162E",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mori_dev.lipanaagreytemu"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07162E",
          "image": "./assets/images/splash-brand-with-agreytemu.png",
          "imageWidth": 310
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Mori Pay to use Face ID to unlock the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mori Pay to scan payment QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mori Pay to access your photos so you can upload your ID for verification.",
          "cameraPermission": "Allow Mori Pay to use the camera so you can photograph your ID for verification.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00CDEF",
          "defaultChannel": "transaction-updates"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://moripay.up.railway.app/api/v1",
      "router": {},
      "eas": {
        "projectId": "5ff03196-ddcc-49a5-a880-ca3bb289a551"
      }
    }
  }
}
