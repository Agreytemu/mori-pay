{
  "expo": {
    "name": "Mori Pay",
    "slug": "lipa-na-agreytemu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mori pay official logo.png",
    "scheme": "lipanaagreytemu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/mori pay official logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/mori pay official logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mori_dev.lipanaagreytemu"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mori pay official logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://mori-pay.onrender.com/api/v1",
      "router": {},
      "eas": {
        "projectId": "5ff03196-ddcc-49a5-a880-ca3bb289a551"
      }
    }
  }
}
