# Public Mori Pay API URL (not a secret). This matches the API host configured
# for Mori Pay's webhook callback. Change it for a different deployment.
VITE_MORI_API_URL=https://moripay.up.railway.app/api/v1

# Public origin this merchant portal is served from. Used for the canonical URL,
# Open Graph tags, robots.txt and sitemap.xml. Replace before deploying.
VITE_SITE_URL=https://merchant.example.com

# Set to "true" only if this application should appear in search engines.
# Private merchant portals should stay "false" (adds noindex and Disallow: /).
VITE_ALLOW_INDEXING=false

# Optional. Google Search Console ownership token. When set, it is injected as
# <meta name="google-site-verification"> in the page head.
# VITE_GOOGLE_SITE_VERIFICATION=
