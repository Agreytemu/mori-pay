# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Mori Pay API
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
# Local Postgres example; on Render use the Internal Database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mori_pay?schema=public

# ─── Cache / queues (optional in dev) ───────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for all (dev only).
CORS_ORIGINS=*

# ─── Auth (generate with: openssl rand -hex 32) ─────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── OTP ────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─── Stakaba (payments) ─────────────────────────────────────────────────────
STAKABA_BASE_URL=https://api.stakaba.com
# Use your sk_test_... key locally. NEVER commit a live key.
STAKABA_API_KEY=
# STAKABA_WEBHOOK_SECRET=

# ─── SMS OTP delivery ───────────────────────────────────────────────────────
# console | beem | nextsms
SMS_PROVIDER=console
# SMS_API_KEY=

# ─── Observability (optional) ───────────────────────────────────────────────
# SENTRY_DSN=
