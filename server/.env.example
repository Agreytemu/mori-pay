# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Mori Pay API
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
# Local Postgres example; on Render use the Internal Database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mori_pay?schema=public

# ─── Cache / queues / session state (optional in dev) ───────────────────────
# REDIS_URL=redis://localhost:6379

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for all (dev only).
CORS_ORIGINS=*

# ─── Auth (generate with: openssl rand -hex 32) ─────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional: dedicated secret for signing receive-code QRs (falls back to JWT_ACCESS_SECRET).
# RECEIVE_QR_SECRET=dev-receive-qr-secret-change-me-32chars

# ─── OTP ────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─── Abliner (payments) ─────────────────────────────────────────────────────
# Docs: https://abliner.net/docs. Amounts are whole TZS.
ABLINER_BASE_URL=https://abliner.net
# Production API keys start with tsl_live_. NEVER commit a live key.
ABLINER_API_KEY=
# Webhook signing secret (starts with whsec_). Required in production:
# it signs deposit requests and verifies inbound webhooks.
# ABLINER_WEBHOOK_SECRET=
# Public HTTPS endpoint Abliner POSTs transaction events to. Must be a real,
# internet-reachable URL in production (local URLs are rejected on boot).
ABLINER_CALLBACK_URL=http://localhost:4000/api/v1/webhooks/abliner
# Approved Abliner Sender ID for outbound SMS (optional).
# ABLINER_SMS_SENDER_ID=

# ─── Reconciliation sweeper ─────────────────────────────────────────────────
# Settles gateway transactions whose webhook never arrived. A missing webhook
# is never treated as failure; rows are re-checked against Abliner.
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=120
RECONCILIATION_STALE_SECONDS=180

# ─── Wallet limits (whole TZS) ──────────────────────────────────────────────
# Rolling 24h outflow ceiling and largest single transaction per tier.
# These defaults are placeholders pending product sign-off; override per env.
LIMIT_STANDARD_DAILY=1000000
LIMIT_STANDARD_PER_TX=500000
LIMIT_VERIFIED_DAILY=5000000
LIMIT_VERIFIED_PER_TX=3000000

# ─── SMS OTP delivery ───────────────────────────────────────────────────────
# console | abliner | beem | nextsms
SMS_PROVIDER=console
# SMS_API_KEY=

# ─── Email verification and password recovery (Resend) ──────────────────────
# Required for email delivery in production; leave unset for development OTPs.

# EMAIL_FROM=auth@your-verified-domain.example

# ─── Observability (optional) ───────────────────────────────────────────────
# SENTRY_DSN=
