# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Mori Pay API
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
# Local Postgres example; on Render use the Internal Database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mori_pay?schema=public

# ─── Cache / queues / session state (optional in dev) ───────────────────────
# REDIS_URL=redis://localhost:6379

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for all (dev only).
CORS_ORIGINS=*

# ─── Auth (generate with: openssl rand -hex 32) ─────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional: dedicated secret for signing receive-code QRs (falls back to JWT_ACCESS_SECRET).
 RECEIVE_QR_SECRET=dev-receive-qr-secret-change-me-32chars
# Generate a unique base64 key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PAYMENT_METHOD_ENCRYPTION_KEY=

# ─── Wallet outflow limits (whole TZS, rolling 24 hours) ─────────────────────
LIMIT_STANDARD_DAILY=1000000
LIMIT_STANDARD_PER_TX=500000
LIMIT_VERIFIED_DAILY=5000000
LIMIT_VERIFIED_PER_TX=3000000

# ─── OTP ────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─── Abliner (payments) ─────────────────────────────────────────────────────
# Docs: https://abliner.net/docs. Amounts are whole TZS.
ABLINER_BASE_URL=https://abliner.net
# Production API keys start with tsl_live_. NEVER commit a live key.
ABLINER_API_KEY=
# The exact Abliner Dashboard webhook signing secret (starts with whsec_).
# Used to sign deposit requests and verify inbound webhooks; do not use the API key.
# ABLINER_WEBHOOK_SECRET=
# Public HTTPS endpoint Abliner POSTs transaction events to. Must be a real,
# internet-reachable URL in production (local URLs are rejected on boot).
ABLINER_CALLBACK_URL=https://moripay.up.railway.app/api/v1/webhooks/abliner
# Approved Abliner Sender ID for outbound SMS (optional).
# ABLINER_SMS_SENDER_ID=

# ─── SMS OTP delivery ───────────────────────────────────────────────────────
# console | abliner | beem | nextsms
SMS_PROVIDER=console
# SMS_API_KEY=

# ─── Email verification and password recovery ───────────────────────────────
# Resend is the primary provider; complete SMTP settings enable fallback delivery.
# Production requires RESEND_API_KEY and EMAIL_FROM.
# Use an address at the verified sending domain.
# For Gmail fallback, use a Google App Password (not the account's normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-google-app-password
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@agreyflix.online

# ─── Observability (optional) ───────────────────────────────────────────────
# SENTRY_DSN=
